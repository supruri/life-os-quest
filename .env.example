# Firebase web app config. Copy to `.env.local` (git-ignored) and fill from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These four values are REQUIRED. Without all of them the app still boots and logs exactly which
# ones are missing, but it stops at the sign-in screen: signing in needs a project. (The DEV-only
# `?preview=<name>` harness still works, because it bypasses auth entirely.)
#
# They are public identifiers, not secrets — they end up in the browser bundle by design. The
# access boundary is Firebase Auth + Firestore security rules. NEVER put a service account key,
# an Admin SDK credential, or any private key in a VITE_* variable: everything prefixed VITE_ is
# inlined into the client bundle and is readable by anyone. The AI worker holds the service
# account server-side, in the aigrow-ai-service repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Calendar sync (unrelated to Firebase; app works without it).
VITE_GOOGLE_CLIENT_ID=
